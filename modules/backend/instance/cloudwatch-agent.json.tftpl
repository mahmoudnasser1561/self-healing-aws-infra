{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/app/access.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/access"
          },
          {
            "file_path": "/var/log/app/error.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/error"
          }
        ]
      }
    }
  }
}
